{
  "provenance": "Independently specified synthetic workflow fixtures. Replay validates contracts and deterministic behavior, not model accuracy or enterprise suitability.",
  "cases": [
    {
      "id": "contradictory_timing",
      "input": {
        "incident_id": "INC-42",
        "window_start": "2026-09-01T10:00:00Z",
        "window_end": "2026-09-01T11:00:00Z",
        "events": [
          {
            "id": "deploy",
            "at": "2026-09-01T10:05:00Z",
            "kind": "deployment",
            "service": "checkout",
            "text": "Checkout version 7 deployed."
          },
          {
            "id": "alert",
            "at": "2026-09-01T10:08:00Z",
            "kind": "alert",
            "service": "checkout",
            "text": "Checkout error rate rose to 8 percent."
          },
          {
            "id": "log",
            "at": "2026-09-01T10:03:00Z",
            "kind": "log",
            "service": "database",
            "text": "Connection timeouts began before the deployment."
          }
        ]
      },
      "replay_responses": [
        {
          "hypotheses": [
            {
              "explanation": "The deployment may contribute, but cannot explain the earlier timeouts.",
              "support": [
                {
                  "source_id": "alert",
                  "quote": "Checkout error rate rose to 8 percent."
                }
              ],
              "contradictions": [
                {
                  "source_id": "log",
                  "quote": "Connection timeouts began before the deployment."
                }
              ],
              "missing_checks": [
                "Did database saturation precede the first timeout?"
              ]
            }
          ],
          "unresolved_questions": [
            "Which dependency first became unhealthy?"
          ]
        }
      ],
      "expected_metrics": {
        "events": 3,
        "hypotheses": 1
      },
      "expected_finding_codes": [
        "contradictory_evidence"
      ]
    },
